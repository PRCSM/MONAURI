# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://monauri.example.com
# Storefront currency (ISO 4217). Prices in src/data/products.ts are in this currency.
NEXT_PUBLIC_CURRENCY=USD
# Optional: forward contact-form submissions to a webhook (Slack, Zapier, Make, your CRM...)
CONTACT_WEBHOOK_URL=
# Optional: payment provider. When unset, checkout runs in clearly-labeled demo mode.
STRIPE_SECRET_KEY=
